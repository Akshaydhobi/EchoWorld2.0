# PORT: Server port (must be 3000 in AI Studio preview)
PORT=3000

# MONGO_URI: Local MongoDB or MongoDB Atlas connection string.
# Local example: mongodb://127.0.0.1:27017/echoworld
# Atlas example: mongodb+srv://<db_username>:<db_password>@<cluster-host>/echoworld?retryWrites=true&w=majority
# For Atlas, create a database user and allow your IP in Network Access.
# URL-encode special characters in the database username or password.
# Leave empty to run with the built-in in-memory fallback store.
MONGO_URI=""

# DEFAULT_WORLD_SEED: Seed integer used to initialize Echo City deterministically
DEFAULT_WORLD_SEED=2026

# GEMINI_API_KEY: Optional for future AI-enhanced reasoning (core engine runs 100% offline without it)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
